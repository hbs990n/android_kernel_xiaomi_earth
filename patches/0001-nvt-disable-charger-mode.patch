+	/*
+	 * earth touch fix: keep the Novatek IC in NORMAL mode, never in
+	 * "charger mode".  When the IC accepts the charger-mode host command
+	 * (0x53) it stops asserting its INT line on this panel, so Android
+	 * receives no input events at all until something re-initialises the
+	 * IC (screen off/on, or a charger re-plug).  That is exactly the
+	 * "touchscreen dead while charging" bug on GSI builds.
+	 * Normal mode (0x51) is harmless on charger, so force it every resume.
+	 */
+	nvt_set_charger_switch(0);
